+// Write the flash status register and wait until the chip has finished (WIP bit clear).
+// Tries the WREN + WRSR sequence first, then EWSR + WRSR, up to 4 times. Returns the final status.
+uint8_t WriteStatus(uint8_t value, bool verbose) {
+  uint8_t st = 0;
+  for (int i = 0; i < 4; i++) {
+    ECommondCommandType t = (i & 1) ? E_CC_WRITE_AFTER_EWSR : E_CC_WRITE_AFTER_WREN;
+    SPICommonCommand(t, 1, 0, 1, value);
+    int n = 0;
+    do {
+      usleep(10000);
+      st = SPICommonCommand(E_CC_READ, 0x5, 1, 0, 0);
+    } while ((st & 1) && ++n < 100);
+    if (verbose)
+      printf("  write status 0x%02x (%s): status now 0x%02x\n", value, (i & 1) ? "EWSR" : "WREN", st);
+    if ((st & 0x9c) == (value & 0x9c)) break;
+  }
+  return st;
+}
+
+// Clear the block protect bits (and SRWD) before erasing / programming.
+uint8_t Unprotect() {
+  return WriteStatus(0, true);
+}
+
+// Protect the blocks again; the status register itself stays unlocked (SRWD clear).
+void Reprotect() {
+  WriteStatus(0x1c, true);
+}
+
+// Safe write test in an unused sector: program one page, read back, erase the sector, read back.
+void WriteTest(uint32_t addr) {
+  uint8_t buf[256], rd[256];
+  SPIRead(addr, rd, 256);
+  for (int i = 0; i < 256; i++) {
+    if (rd[i] != 0xff) {
+      printf("Test page 0x%05x is not empty, test skipped.\n", addr);
+      return;
+    }
+  }
+  printf("Write test at 0x%05x:\n", addr);
+  uint8_t st = Unprotect();
+  printf("  status before test: 0x%02x\n", st);
+  for (int i = 0; i < 256; i++) buf[i] = i;
+  WriteReg(0x71, 255);
+  WriteReg(0x64, addr >> 16);
+  WriteReg(0x65, addr >> 8);
+  WriteReg(0x66, addr);
+  for (int i = 0; i < 256; i += 32) WriteBytesToAddr(0x70, buf + i, 32);
+  WriteReg(0x6f, 0xa0);
+  while (ReadReg(0x6f) & 0x40) {}
+  usleep(10000);
+  SPIRead(addr, rd, 256);
+  int ok = 0;
+  for (int i = 0; i < 256; i++) ok += rd[i] == buf[i];
+  printf("  page program: %d of 256 bytes written (first bytes %02x %02x %02x %02x)\n", ok, rd[0], rd[1], rd[2], rd[3]);
+  printf("  status after program: 0x%02x\n", SPICommonCommand(E_CC_READ, 0x5, 1, 0, 0));
+  SPICommonCommand(E_CC_ERASE, 0x20, 0, 3, addr);   // 4 KB sector erase
+  for (int n = 0; n < 100 && (SPICommonCommand(E_CC_READ, 0x5, 1, 0, 0) & 1); n++) usleep(10000);
+  SPIRead(addr, rd, 256);
+  int ff = 0;
+  for (int i = 0; i < 256; i++) ff += rd[i] == 0xff;
+  printf("  sector erase: %d of 256 bytes erased\n", ff);
+  if (ff != 256)
+    printf("  WARNING: the test pattern is still in flash at 0x%05x (harmless, the area is unused)\n", addr);
+  printf("  status after test: 0x%02x\n", SPICommonCommand(E_CC_READ, 0x5, 1, 0, 0));
+  Reprotect();
+  printf("  status after reprotect: 0x%02x\n", SPICommonCommand(E_CC_READ, 0x5, 1, 0, 0));
+}
